<ui:FluentWindow x:Class="HardwareMonitor.DiagnosticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Icon="{DynamicResource AppIcon}" Title="Диагностика датчиков" Width="920" Height="600" MinWidth="600" MinHeight="400"
        ExtendsContentIntoTitleBar="True" WindowStartupLocation="CenterOwner" WindowBackdropType="Mica">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="Диагностика датчиков" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
        <ScrollViewer Grid.Row="1" Margin="15,10,15,0" MaxHeight="170" VerticalScrollBarVisibility="Auto">
            <TextBlock x:Name="StatusText" Text="Ожидание показаний…" TextWrapping="Wrap"/>
        </ScrollViewer>
        <TextBlock Grid.Row="2" Text="Все исходные датчики, включая скрытые в основном окне. Значение — означает отсутствие данных."
                   FontSize="12" TextWrapping="Wrap" Margin="15,10" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
        <DataGrid x:Name="SensorGrid" Grid.Row="3" Margin="15,0,15,15" IsReadOnly="True" AutoGenerateColumns="False"
                  CanUserAddRows="False" CanUserDeleteRows="False" EnableRowVirtualization="True"
                  EnableColumnVirtualization="True" HeadersVisibility="Column" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Устройство" Binding="{Binding HardwareName}" Width="180"/>
                <DataGridTextColumn Header="Исходное имя" Binding="{Binding Name}" Width="190"/>
                <DataGridTextColumn Header="Идентификатор" Binding="{Binding Identifier}" Width="230"/>
                <DataGridTextColumn Header="Тип" Binding="{Binding TypeName}" Width="110"/>
                <DataGridTextColumn Header="Значение" Binding="{Binding Value}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</ui:FluentWindow>
