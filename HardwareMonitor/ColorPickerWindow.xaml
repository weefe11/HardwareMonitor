<ui:FluentWindow x:Class="HardwareMonitor.ColorPickerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:local="clr-namespace:HardwareMonitor"
    Title="Цвет текста" Width="390" Height="440" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
    ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica" Icon="{DynamicResource AppIcon}">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <ui:TitleBar Title="Цвет текста" ShowMaximize="False"/>
        <StackPanel Grid.Row="1" Margin="20,10,20,16">
            <TextBlock Text="Выберите оттенок и яркость" Margin="0,0,0,10" FontSize="14"/>
            <Canvas x:Name="ColorField" Height="160" ClipToBounds="True" Background="Transparent" MouseLeftButtonDown="Field_MouseDown" MouseMove="Field_MouseMove" MouseLeftButtonUp="Field_MouseUp" SizeChanged="Field_SizeChanged" Focusable="True" KeyDown="Field_KeyDown" ToolTip="Выберите цвет мышью или стрелками клавиатуры">
                <Rectangle x:Name="HueSurface" Width="{Binding ActualWidth, ElementName=ColorField}" Height="160" IsHitTestVisible="False"/>
                <Rectangle Width="{Binding ActualWidth, ElementName=ColorField}" Height="160" IsHitTestVisible="False"><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="White" Offset="0"/><GradientStop Color="#00FFFFFF" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle>
                <Rectangle Width="{Binding ActualWidth, ElementName=ColorField}" Height="160" IsHitTestVisible="False"><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#00000000" Offset="0"/><GradientStop Color="Black" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle>
                <Ellipse x:Name="MarkerEdge" Width="12" Height="12" Stroke="Black" StrokeThickness="3" IsHitTestVisible="False"/>
                <Ellipse x:Name="Marker" Width="12" Height="12" Stroke="White" StrokeThickness="1.5" IsHitTestVisible="False"/>
            </Canvas>
            <TextBlock Text="Оттенок" Margin="0,10,0,4"/>
            <Rectangle Height="8" RadiusX="3" RadiusY="3"><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="Red" Offset="0"/><GradientStop Color="Yellow" Offset="0.1667"/><GradientStop Color="Lime" Offset="0.3333"/><GradientStop Color="Cyan" Offset="0.5"/><GradientStop Color="Blue" Offset="0.6667"/><GradientStop Color="Magenta" Offset="0.8333"/><GradientStop Color="Red" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle>
            <Slider x:Name="HueSlider" Minimum="0" Maximum="360" ValueChanged="Hue_Changed" Margin="0,0,0,8"/>
            <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions><TextBlock Text="Код цвета" VerticalAlignment="Center"/><TextBox x:Name="HexBox" Grid.Column="1" MaxLength="7" LostFocus="Hex_LostFocus" PreviewKeyDown="Hex_KeyDown" ToolTip="Необязательный код цвета, например #43BFEA"/></Grid>
            <Grid Height="28" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Background="#E9EDF3"><local:OutlinedText x:Name="LightPreview" Text="ЦП 57 °C | 18 %"/></Border>
                <Border Grid.Column="1" Background="#20242A"><local:OutlinedText x:Name="DarkPreview" Text="ЦП 57 °C | 18 %"/></Border>
            </Grid>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Отмена" IsCancel="True" MinWidth="90"/><Button Content="Применить" Click="Apply_Click" IsDefault="True" MinWidth="100" Margin="8,0,0,0"/></StackPanel>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
