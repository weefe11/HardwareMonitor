<ui:FluentWindow x:Class="HardwareMonitor.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Мониторинг ПК" Width="540" Height="760" MinWidth="490" MinHeight="640"
    Icon="{DynamicResource AppIcon}" WindowBackdropType="Mica" ExtendsContentIntoTitleBar="True" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="CompactExpander" TargetType="Expander">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <StackPanel>
                            <ToggleButton IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent" Padding="0,4">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/></Grid.ColumnDefinitions>
                                                <ContentPresenter Content="{Binding Header, RelativeSource={RelativeSource AncestorType=Expander}}" VerticalAlignment="Center"/>
                                                <Path x:Name="Arrow" Grid.Column="1" Data="M 0 0 L 4 4 L 8 0" Stroke="{DynamicResource TextFillColorSecondaryBrush}" StrokeThickness="1.4" VerticalAlignment="Center" HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="Arrow" Property="RenderTransform"><Setter.Value><RotateTransform Angle="180"/></Setter.Value></Setter></Trigger>
                                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Foreground" Value="{DynamicResource SystemAccentColorPrimaryBrush}"/></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="Body" ContentSource="Content" Visibility="Collapsed" HorizontalAlignment="Stretch"/>
                        </StackPanel>
                        <ControlTemplate.Triggers><Trigger Property="IsExpanded" Value="True"><Setter TargetName="Body" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="SensorRow">
            <Grid Margin="4,3" MinHeight="28">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="108"/><ColumnDefinition Width="16"/></Grid.ColumnDefinitions>
                <TextBlock Grid.Column="2" Text="{Binding WarningSymbol}" Foreground="{Binding WarningBrush}" FontWeight="Bold" ToolTip="{Binding RangeText}" VerticalAlignment="Center" TextAlignment="Center"/>
                <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Grid.Column="1" Text="{Binding Value}" ToolTip="{Binding RangeText}" FontFamily="Consolas" FontSize="13"
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontWeight="SemiBold" TextAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
        </DataTemplate>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <ui:TitleBar Title="Мониторинг ПК"><ui:TitleBar.Icon><ui:ImageIcon Source="{DynamicResource AppIcon}"/></ui:TitleBar.Icon></ui:TitleBar>
        <Grid Grid.Row="1" Margin="20,12,20,16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Показатели системы" FontSize="20" FontWeight="SemiBold"/>
                <TextBlock Text="Выберите показатели для виджета" FontSize="12" Margin="0,5,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
            <ui:ToggleSwitch Grid.Column="1" x:Name="ThemeToggle" Content="Тёмная тема" VerticalAlignment="Center" IsChecked="True" Checked="ThemeToggle_Checked" Unchecked="ThemeToggle_Unchecked"/>
        </Grid>
        <ScrollViewer x:Name="SensorsScroll" Grid.Row="2" Margin="20,0,20,10" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="SensorsList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Margin="0,0,0,10" Padding="2">
                            <Expander IsExpanded="True" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch">
                                <Expander.Header>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"/>
                                        <TextBlock Text="{Binding Subtitle}" FontSize="12" MaxWidth="370" TextTrimming="CharacterEllipsis" ToolTip="{Binding Subtitle}"
                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                            <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding Subtitle}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Expander.Header>
                                <StackPanel Margin="12,0,12,10">
                                    <ItemsControl ItemsSource="{Binding Sensors}" ItemTemplate="{StaticResource SensorRow}"/>
                                    <ItemsControl ItemsSource="{Binding SubGroups}">
                                        <ItemsControl.ItemTemplate><DataTemplate>
                                            <Expander Style="{StaticResource CompactExpander}" IsExpanded="False" Margin="0,4,0,0">
                                                <Expander.Header><CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected, Mode=TwoWay}" FontSize="12" MinHeight="0" Height="26" Padding="0"/></Expander.Header>
                                                <ItemsControl ItemsSource="{Binding Sensors}" ItemTemplate="{StaticResource SensorRow}" Margin="12,4,0,0"/>
                                            </Expander>
                                        </DataTemplate></ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Expander>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        <Border Grid.Row="3" Margin="20,0,20,16" Padding="14" CornerRadius="8" Background="{DynamicResource ControlFillColorDefaultBrush}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <CheckBox x:Name="OverlayCheckbox" Content="Показать виджет" FontWeight="SemiBold" Checked="OverlayCheckbox_Checked" Unchecked="OverlayCheckbox_Unchecked"/>
                    <CheckBox Grid.Column="1" x:Name="LockPositionCheckbox" Content="Закрепить" ToolTip="Закреплённый виджет пропускает щелчки мыши в окна под ним" Checked="LockPositionCheckbox_Checked" Unchecked="LockPositionCheckbox_Unchecked"/>
                </Grid>
                <TextBlock x:Name="SelectionSummary" FontSize="12" Margin="0,8,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                <Expander x:Name="AppearanceExpander" Style="{StaticResource CompactExpander}" Header="Отображение и управление" IsExpanded="False" Margin="0,10,0,0">
                    <ScrollViewer MaxHeight="300" Padding="0,0,18,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,8,4,2">
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Цвет текста" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                <Button Grid.Column="1" Click="ChooseColor_Click" ToolTip="Выбрать любой цвет в палитре" Padding="10,5">
                                    <StackPanel Orientation="Horizontal">
                                        <Rectangle x:Name="CurrentColorPreview" Width="18" Height="18" RadiusX="2" RadiusY="2" Stroke="#808080" StrokeThickness="1" Margin="0,0,8,0"/>
                                        <TextBlock x:Name="ColorHex" FontFamily="Consolas" VerticalAlignment="Center" FontSize="13"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <CheckBox x:Name="OutlineCheckbox" Content="Обводка текста" Margin="0,12,0,10" Checked="Appearance_Changed" Unchecked="Appearance_Changed"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Прозрачность текста" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                <Slider x:Name="TransparencySlider" Grid.Column="1" Margin="0,0,12,0" Minimum="0" Maximum="90" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="Transparency_Changed" VerticalAlignment="Center" ToolTip="Прозрачность букв и обводки. Фона у виджета нет."/>
                                <TextBlock Grid.Column="2" Text="{Binding Value, ElementName=TransparencySlider, StringFormat={}{0:0}%}" TextAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            </Grid>
                            <Grid Margin="0,8,0,12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Размер текста" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                <Slider x:Name="TextSizeSlider" Grid.Column="1" Margin="0,0,12,0" Minimum="12" Maximum="20" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="TextSize_Changed"/>
                                <TextBlock Grid.Column="2" Text="{Binding Value, ElementName=TextSizeSlider, StringFormat={}{0:0}}" TextAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            </Grid>
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="160"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Показать / скрыть виджет" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                <TextBox x:Name="OverlayHotkeyBox" Grid.Column="1" IsReadOnly="True" PreviewKeyDown="HotkeyBox_PreviewKeyDown" Tag="Overlay" Text="Не задан" ToolTip="Нажмите комбинацию клавиш. Delete — убрать привязку."/>
                                <TextBlock Grid.Row="1" Text="Закрепить / переместить" VerticalAlignment="Center" FontSize="12" Margin="0,8,0,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                <TextBox x:Name="LockHotkeyBox" Grid.Row="1" Grid.Column="1" IsReadOnly="True" PreviewKeyDown="HotkeyBox_PreviewKeyDown" Tag="Lock" Text="Не задан" Margin="0,8,0,0" ToolTip="Нажмите комбинацию клавиш. Delete — убрать привязку."/>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button Content="Сбросить мин./макс." Click="ResetRanges_Click" Padding="8,4"/>
                                <Button Content="Диагностика датчиков" Click="Diagnostics_Click" Padding="8,4" Margin="8,0,0,0"/>
                            </StackPanel>
                            <TextBlock Text="Мин./макс. — при наведении на значение. Настройки сохраняются автоматически." FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </ScrollViewer>
                </Expander>
                <TextBlock x:Name="HardwareStatus" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                <TextBlock x:Name="SettingsStatus" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed"/>
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
